      {"key": "event_date", "label": "Event date", "type": "date", "required": true},
      {"key": "start_time", "label": "Start time", "type": "text", "required": true},
      {"key": "end_time", "label": "End time", "type": "text", "required": true},
      {"key": "brief_description", "label": "Brief description", "type": "longtext", "required": true},
      {"key": "objective", "label": "Objective", "type": "longtext", "required": true},
      {"key": "expected_participants", "label": "Number of participants", "type": "text", "required": true},
      {"key": "mode", "label": "Mode", "type": "text", "required": true, "options": ["Offline", "Online", "Hybrid"]},
      {"key": "event_organizers", "label": "Event organizers", "type": "text", "required": true},
      {"key": "tech_name", "label": "Tech assistant: name", "type": "text", "required": true},
      {"key": "tech_designation", "label": "Tech assistant: designation", "type": "text", "required": true},
      {"key": "tech_branch", "label": "Tech assistant: branch", "type": "text", "required": false},
      {"key": "tech_mobile", "label": "Tech assistant: mobile", "type": "text", "required": false},
      {"key": "incharge_name", "label": "Faculty in-charge: name", "type": "text", "required": true},
      {"key": "incharge_designation", "label": "Faculty in-charge: designation", "type": "text", "required": true},
      {"key": "incharge_branch", "label": "Faculty in-charge: branch", "type": "text", "required": false}
