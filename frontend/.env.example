# Where the Vite dev server forwards /api/* (the FastAPI backend)
BACKEND_URL=http://127.0.0.1:8000

# Only for production builds served from a different origin than the backend.
# Leave empty in development (the /api proxy is used).
# VITE_API_URL=https://your-backend.example.com

# The backend has no /clubs endpoint yet, so the club id is configured here.
VITE_CLUB_ID=1
